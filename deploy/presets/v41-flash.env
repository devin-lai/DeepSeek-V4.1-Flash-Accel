# DeepSeek-V4.1-Flash (552B backbone + 196B Engram, MXFP4 experts) on 8x 32 GB.
#
# This is the configuration that serves. Every flag below is load-bearing;
# docs/05-fault-inventory.md says which fault each one answers.
#
# Requires the patches in upstream/ — see upstream/README.md:
#   python upstream/flashinfer/apply_patch.py "$(PKG flashinfer)"
#   mv "$(PKG flashinfer_jit_cache)/jit_cache/sparse_mla_sm120" /var/tmp/   # FI-002
#   python upstream/vllm/apply_patch.py "$(PKG vllm)"
#
# Host RAM is the binding constraint, not GPU memory: Engram pins ~264 GiB
# (PT-001 rounding) and each rank's offload budget is on top of that.
MODEL="${MODEL:-/data/models/DeepSeek-V4.1-Flash}"
SERVED_NAME=deepseek-v4.1-flash
TOKENIZER_MODE=deepseek_v41
TP=8
EXPERT_PARALLEL=1          # VL-006: whole experts, no MXFP4 padding
GPU_UTIL=0.93
MAX_LEN=32768
MAX_SEQS=16
ENGRAM_OFFLOAD=1
ENGRAM_GIB=264
OFFLOAD_GB=12              # per rank; tools/plan_memory.py reports the minimum
OFFLOAD_LAYERS=20-39       # decoder layers only: CED prefill runs 0-19
BLOCK_SIZE=64              # VL-009: indexer STATES per block, x compress_ratio
                           # per layer. 64 is the only value DeepGEMM takes on
                           # sm_120 with an FP8 indexer cache.
TEXT_ONLY=1                # FI-003 / VL-011: the sm_120 dual-cache sparse-MLA
                           # prefill kernel is instantiated only at topk=128,
                           # which is the SWA window with no image tokens.
ENFORCE_EAGER=0            # Graph mode: 33.7 vs 6.0 output tok/s in the saved
                           # single-request comparison. All patches required.
                           # Set to 1 for eager diagnosis; other patches still apply.
MOE_BACKEND=marlin
REASONING_PARSER=deepseek_v41
TOOL_PARSER=deepseek_v41
