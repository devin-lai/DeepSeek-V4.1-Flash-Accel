# DeepSeek-V4-Flash (NVFP4) on 8x RTX 5090 -- the balanced default.
# Measured: 117.9 tok/s single stream, 580.4 at 8, 1385.3 at 32, 14 499 tok/s
# prefill on 8K prompts, ~120 s to ready.
MODEL="${MODEL:-/data/models/DeepSeek-V4-Flash-NVFP4}"
SERVED_NAME=deepseek-v4-flash
TOKENIZER_MODE=deepseek_v4
TP=8
EXPERT_PARALLEL=1          # +79 % single stream, +94 % at 8 streams (VL-006)
GPU_UTIL=0.90
MAX_LEN=65536
MAX_SEQS=32
OFFLOAD_GB=0               # NVFP4 fits in 8x32 GiB; do not pay VL-007
