# Short interactive requests: more resident expert weights, smaller KV cache.
# 8x RTX 5090 D, measured with plugin 0.3.0, pinned stack and repository patches.
# See benchmarks/results/2026-09-15-staging-and-batching.md for tradeoffs.
source "$(dirname "${BASH_SOURCE[0]}")/v41-flash-latency.env"
OFFLOAD_GB=9.75
GPU_UTIL=0.96
MAX_SEQS=8
MAX_BATCHED_TOKENS=2048
# Explicit KV bytes take precedence over utilization-based memory profiling.
# Reported capacity: 35,852 tokens; this is not 8 simultaneous 32K contexts.
KV_CACHE_MEMORY_BYTES=268435456
MARLIN_STAGE_MIN_TOKENS=0
COMPILATION_CONFIG='{"cudagraph_capture_sizes":[1,2,4,6,8,12,18,24,30,36,42,48]}'
