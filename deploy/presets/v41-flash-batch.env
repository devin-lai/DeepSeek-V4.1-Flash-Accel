# Aggregate batch throughput with exact packed-weight staging.
# Requires plugin >=0.3.0 and the pinned stack/patches.
# Larger batches trade per-token and tail latency for aggregate output.
source "$(dirname "${BASH_SOURCE[0]}")/v41-flash-throughput.env"
MAX_SEQS=64
MARLIN_STAGE_MIN_TOKENS=256
COMPILATION_CONFIG='{"cudagraph_capture_sizes":[1,2,4,8,16,24,32,40,48,56,64]}'
