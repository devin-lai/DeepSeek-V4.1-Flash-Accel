# Text throughput preset, measured on 8x RTX 5090, 2026-09-14.
# Requires vllm-dsv41-opt >=0.2.0. The wider batch trades per-request token
# latency for aggregate throughput; use v41-flash-latency for interactive use.
source "$(dirname "${BASH_SOURCE[0]}")/v41-flash.env"
EXACT_PINNED=1
ENGRAM_GIB=189
OFFLOAD_GB=9
GPU_UTIL=0.95
MAX_SEQS=32
MAX_BATCHED_TOKENS=2048
