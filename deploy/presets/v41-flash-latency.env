# Text latency preset, measured on 8x RTX 5090, 2026-09-14.
# Requires vllm-dsv41-opt >=0.2.0 and the pinned stack/patches.
# See benchmarks/results/2026-09-14-v41-optimization.md for paired trials.
source "$(dirname "${BASH_SOURCE[0]}")/v41-flash.env"
EXACT_PINNED=1
ENGRAM_GIB=189
OFFLOAD_GB=11
GPU_UTIL=0.95
MAX_SEQS=16
MAX_BATCHED_TOKENS=2048
# SM120's DeepseekV41IndexerBackend does not support adaptive verification.
SPECULATIVE_CONFIG='{"method":"dspark","num_speculative_tokens":5,"enable_adaptive_verification":false,"draft_sample_method":"probabilistic"}'
# Static verification needs up to 16 * (5 + 1) query tokens. Avoid capturing
# the default larger shapes and reserve the recovered memory for weights/KV.
COMPILATION_CONFIG='{"cudagraph_capture_sizes":[1,2,4,6,8,12,16,18,24,30,36,42,48,54,60,66,72,78,84,90,96]}'
