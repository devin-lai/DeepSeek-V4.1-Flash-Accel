# Lowest time-per-token for a small number of concurrent users.
#
# Deliberately NOT enabling MTP speculative decoding: on this box expert
# parallelism alone reaches 117.9 tok/s single-stream, while TP8+MTP reached
# only 101.6 and cost 74 % of 8K prefill and nearly half of 32-stream
# throughput. MTP is a win over a *non-EP* baseline (65.7 -> 101.6), not over
# this one.
source "$(dirname "${BASH_SOURCE[0]}")/default.env"
MAX_SEQS=8
MAX_LEN=32768
GPU_UTIL=0.90
